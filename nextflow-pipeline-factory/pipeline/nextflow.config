// nextflow.config = the CONTROL ROOM: where the factory runs, how much power, which settings.
// Moving to a new computer? Change this file. main.nf (the blueprint) stays the same.

params {
    reads         = "data/*_R{1,2}.fastq.gz"   // the * becomes the sample name: S1_R1.fastq.gz -> "S1"
    transcriptome = "data/transcripts.fa.gz"   // gene sequences, used to build the gene map
    samplesheet   = "data/samples.csv"         // columns: sample,condition
    outdir        = "results"
}

process {
    cpus   = 2
    memory = '4 GB'
    withName: QUANT  { cpus = 8; memory = '16 GB' }
    withName: DESEQ2 { container = 'quay.io/biocontainers/bioconductor-deseq2:1.42.0--r43hf17093f_2' }
}

profiles {
    standard {                       // your laptop, software from conda
        process.executor = 'local'
        conda.enabled    = true
        process.conda    = "$projectDir/environment.yml"
    }
    docker {                         // your laptop, software from Docker
        docker.enabled    = true
        process.container = 'combinelab/salmon:1.10.3'
    }
    slurm {                          // a computing cluster
        process.executor    = 'slurm'
        process.queue       = 'medium'
        singularity.enabled = true
    }
}
