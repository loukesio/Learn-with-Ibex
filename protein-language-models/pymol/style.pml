# Shared look: white background, cartoon, soft shadows, 1920x1260 ray-traced PNG
bg_color white
set ray_opaque_background, 1
set cartoon_fancy_helices, 1
set cartoon_transparency, 0
set ray_trace_mode, 1
set ray_trace_gain, 0.004
set ray_trace_color, 0x222222
set antialias, 2
set ambient, 0.35
set spec_reflect, 0.1
set ray_shadow, 0
hide everything
